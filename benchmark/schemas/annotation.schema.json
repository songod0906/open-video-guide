{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-video-guide.org/benchmark/schemas/annotation.schema.json",
  "title": "Open Video Guide Benchmark Annotation",
  "description": "Reviewed tutorial steps for one benchmark source video.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "source_sha256",
    "review",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_count",
        "reviewed_at",
        "method"
      ],
      "properties": {
        "status": {
          "enum": [
            "seed_single_review",
            "double_reviewed",
            "adjudicated"
          ]
        },
        "reviewer_count": {
          "type": "integer",
          "minimum": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_ms",
        "region"
      ],
      "properties": {
        "time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "region": {
          "$ref": "#/$defs/region"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "order",
        "title",
        "instruction",
        "start_ms",
        "end_ms",
        "screenshot"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^step-[0-9]{2}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "screenshot": {
          "$ref": "#/$defs/screenshot"
        }
      }
    }
  }
}
