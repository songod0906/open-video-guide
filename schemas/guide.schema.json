{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-video-guide.org/schemas/guide.schema.json",
  "title": "Open Video Guide",
  "description": "A versioned guide with evidence from one source video.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guide_id",
    "title",
    "source",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "guide_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "duration_ms",
        "sha256"
      ],
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start_ms",
        "end_ms"
      ],
      "properties": {
        "kind": {
          "enum": [
            "frame",
            "transcript",
            "ocr",
            "motion"
          ]
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "asset_path": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "order",
        "title",
        "instruction",
        "start_ms",
        "end_ms",
        "confidence",
        "review_state",
        "evidence"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "format": "uuid"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "screenshot_path": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_state": {
          "enum": [
            "unreviewed",
            "accepted",
            "changed",
            "rejected"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  }
}
